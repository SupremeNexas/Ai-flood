    { "id": "flow-gt-prep", "from": "gt_mask", "to": "gt_prep", "label": "QC split", "classification": "ground truth", "variant": "dashed" },
    { "id": "flow-prep-tensor", "from": "gt_prep", "to": "gt_tensor", "label": "clean mask", "classification": "ground truth", "variant": "dashed" },
    { "id": "flow-tensor-eval", "from": "gt_tensor", "to": "eval_engine", "label": "truth grid", "classification": "ground truth", "variant": "dashed" },
    { "id": "flow-mask-results", "from": "binary_mask", "to": "benchmark_results", "label": "prediction", "classification": "inference", "variant": "dashed", "route": "straight", "labelDy": 24 },
    { "id": "flow-eval-metrics", "from": "eval_engine", "to": "benchmark_results", "label": "scoring", "classification": "evaluation", "variant": "dashed" }
