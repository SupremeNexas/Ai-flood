    { "id": "unet_core", "type": "backend", "brand": "pytorch", "label": "PyTorch U-Net", "sublabel": "7.76M Params", "stage": 3, "row": 0, "tag": "GroupNorm G=8" },
    { "id": "eval_engine", "type": "backend", "label": "Evaluation Core", "sublabel": "Confusion Matrix", "stage": 3, "row": 2, "tag": "TP / FP / TN / FN" },

    { "id": "prob_map", "type": "backend", "label": "Probability Map", "sublabel": "Sigmoid [0.0, 1.0]", "stage": 4, "row": 0, "tag": "Flood Probability" },
    { "id": "binary_mask", "type": "backend", "label": "Binary Flood Mask", "sublabel": "Nominal Area km²", "stage": 4, "row": 1, "tag": "Cutoff τ = 0.50" },
    { "id": "benchmark_results", "type": "backend", "label": "Official Metrics", "sublabel": "IoU: 0.5548 | F1: 0.7137", "stage": 4, "row": 2, "tag": "P: 0.7717 | R: 0.6637" }
