  "cards": [
    {
      "dot": "cyan",
      "title": "Radiometric Data Pipeline",
      "items": [
        "Sentinel-1 SAR C-band VV and VH backscatter clipped to [-35.0, 5.0] dB",
        "Min-max normalized to [0.0, 1.0] and resized to standard 256x256 tensor grid",
        "Dual-polarization provides critical sensitivity to open surface water and flooded vegetation"
      ]
    },
    {
      "dot": "emerald",
      "title": "Inference & Mapping",
      "items": [
        "PyTorch U-Net computes continuous flood probabilities with Sigmoid activation",
        "Thresholding at τ=0.50 yields binary segmentation masks (0: Land, 1: Water)",
        "Nominal Flooded Area computed via 10m x 10m Ground Sample Distance (100 m²/pixel)"
      ]
    },
    {
      "dot": "amber",
      "title": "Rigorous Evaluation",
      "items": [
        "Tested across all 90 official Sen1Floods11 benchmark test chips without data leakage",
        "Achieves 0.5548 IoU, 0.7137 Dice/F1, 0.7717 Precision, 0.6637 Recall, and 0.9334 Accuracy",
        "Invalid pixels (-1: sensor no-data / cloud shadow) strictly masked out during evaluation"
      ]
    }
  ]
