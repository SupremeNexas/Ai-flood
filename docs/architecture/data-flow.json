  "nodes": [
    { "id": "raw_sar", "type": "external", "label": "Sentinel-1 SAR", "sublabel": "VV + VH 16-bit", "stage": 0, "row": 0, "tag": "C-band 5.4GHz" },
    { "id": "gt_mask", "type": "database", "label": "Sen1Floods11 GT", "sublabel": "Hand-Labeled Masks", "stage": 0, "row": 2, "tag": "90 Test Chips" },

    { "id": "sar_norm", "type": "backend", "label": "dB Calibration", "sublabel": "[-35, 5]dB -> [0, 1]", "stage": 1, "row": 0, "tag": "Min-Max Scale" },
