    { "id": "flow-tensor-unet", "from": "tensor_gen", "to": "unet_core", "label": "tensor feed", "classification": "inference", "variant": "emphasis" },
    { "id": "flow-unet-prob", "from": "unet_core", "to": "prob_map", "label": "logits", "classification": "probability", "variant": "emphasis" },
